# Public URL of the API (no trailing slash). Leave empty in development: Vite proxies /api to http://localhost:4000
VITE_API_URL=
# Where people land after signing in, and the default when no (or an untrusted) redirect is given
VITE_APP_URL=http://localhost:5173
# Extra origins allowed as redirect targets, comma separated (other *.shefin.dev apps)
VITE_ALLOWED_REDIRECTS=
