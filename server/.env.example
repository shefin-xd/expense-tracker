NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusledger
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# The separate sign-in app. Production: https://auth.shefin.dev
AUTH_URL=http://localhost:5174
# Production: set to .shefin.dev so the cookie works across expenses.shefin.dev and api.shefin.dev
COOKIE_DOMAIN=
# Password-reset emails are sent with Mailtrap's HTTP API (https://mailtrap.io).
#  - Live sending: verify your sending domain in Mailtrap, create an API token, set EMAIL_FROM to an address on that domain.
#  - Testing only: also set MAILTRAP_INBOX_ID; mail lands in that Mailtrap inbox and is never delivered to real people.
#  - Leave MAILTRAP_API_TOKEN empty in development: the reset link is printed in the server console instead.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
EMAIL_FROM=CampusLedger <no-reply@yourdomain.dev>
# Only used by `npm run seed:owner`
OWNER_EMAIL=
OWNER_PASSWORD=
