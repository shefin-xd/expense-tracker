NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusledger
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# For cross-site deployments, keep CLIENT_URL as the exact frontend origin and set COOKIE_DOMAIN to the parent domain.
# Example: CLIENT_URL=https://app.example.com and COOKIE_DOMAIN=.example.com
# In production, the auth cookie must be Secure + SameSite=None when the frontend and API are on different origins.
COOKIE_DOMAIN=
# Only used by `npm run seed:owner`
OWNER_EMAIL=
OWNER_PASSWORD=
