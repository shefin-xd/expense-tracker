NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusledger
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
# Set this to the exact frontend origin, or a comma-separated list for preview/alternate hosts.
CLIENT_URL=http://localhost:5173
# For cross-site cookies on subdomains, use a parent domain like .example.com.
# Example: CLIENT_URL=https://app.example.com,https://www.example.com and COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=
# Only used by `npm run seed:owner`
OWNER_EMAIL=
OWNER_PASSWORD=
